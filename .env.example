# ひな形。実際の値は .env.local に書く(git には上がりません)。
# Vercel では「Project → Settings → Environment Variables」に同じ名前で入れる。

# ---- データベース ----------------------------------------------------------
# Vercel はファイルを保存できないので、SQLite ファイル(data/aiment.db)は使えません。
# ホスティング先のPostgres(Neon など)の接続文字列をここに入れます。
# ローカルで空にしておけば、今までどおり data/aiment.db を使います。
DATABASE_URL=

# ---- Googleログイン --------------------------------------------------------
# openssl rand -base64 32 で作る
AUTH_SECRET=
# Google Cloud Console → 認証情報 → OAuth 2.0 クライアント ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 入れる人のメールアドレスをカンマ区切りで。ここに無い人は入れません。
ALLOWED_EMAILS=you@example.com,partner@example.com
