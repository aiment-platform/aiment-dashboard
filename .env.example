# ひな形。ローカルは .env.local に、本番は Vercel の
# 「Project → Settings → Environment Variables」に同じ名前で入れます。
# .env.local は git に上がりません(.gitignore 済み)。

# ---- データベース ----------------------------------------------------------
# Vercel はファイルを保存できないので、Postgres につなぎます(Neon など)。
# Neon なら「Pooled connection」の文字列を使ってください。
#   例) postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/aiment?sslmode=require
# ローカルで動かすなら:
#   brew install postgresql@17 && brew services start postgresql@17 && createdb aiment
DATABASE_URL=postgresql://localhost:5432/aiment

# ---- ふたりで同時に見るための線(任意) ---------------------------------------
# 相手の変更が即座に映り、相手のカーソルが見えるようになります。
# 入れなければ、その機能が無いだけで普通に動きます(再読み込みで最新になる)。
#
# liveblocks.io で無料のアカウントを作り、
# 「Dashboard → プロジェクト → API keys」の **secret key**(sk_ で始まるもの)を入れる。
# 無料枠: 1つの盤に同時10人まで / 月3,000接続。2人なら余ります。
#
# ここに流すのは**カーソルと「変わったよ」の合図だけ**です。
# 積み木のデータ本体は Postgres にしか置きません(正しいデータの置き場所を1つに保つため)。
LIVEBLOCKS_SECRET_KEY=

# ---- ログインについて ------------------------------------------------------
# このアプリにログインはありません。開くと Soya / Futo / Other から選ぶだけです。
# 「誰が開けるか」は Vercel の Deployment Protection(許可メールアドレス)で決めます:
#   Vercel → Project → Settings → Deployment Protection → Vercel Authentication
# これを切ると URL を知っている全員が見られるので、必ず有効にしてください。
#
# /api/v1/* も Deployment Protection の内側です。外の道具(エージェント等)から
# 叩きたくなったら、Vercel の「Protection Bypass for Automation」を使います。
# アプリ側に別のトークンは持たせていません。
